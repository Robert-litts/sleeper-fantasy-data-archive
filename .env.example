DATABASE_URL=postgres://sleeper:sleeper@localhost:5434/sleeper_archive?sslmode=disable
SLEEPER_USER_ID=
SLEEPER_SPORT=nfl
START_SEASON=2022
END_SEASON=2025
SLEEPER_API_BASE_URL=https://api.sleeper.app/v1
HTTP_TIMEOUT=30s
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
